generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  password         String
  role             UserRole        @default(PEKERJA)
  avatar           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deliveries       DeliveryLog[]
  harvestReviewed  HarvestReport[] @relation("HarvestReviewed")
  harvestSubmitted HarvestReport[] @relation("HarvestSubmitted")
  inventoryLogs    InventoryLog[]
  productionLogs   ProductionLog[]
  transactions     Transaction[]
  categoryRequests CategoryRequest[] @relation("CategoryRequestedBy")

  @@map("users")
}

model Account {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         AccountType
  description  String?
  isActive     Boolean       @default(true)
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@map("accounts")
}

model Transaction {
  id           String            @id @default(cuid())
  date         DateTime          @default(now())
  description  String
  reference    String?
  status       TransactionStatus @default(DRAFT)
  userId       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  journalLines JournalLine[]
  user         User              @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model JournalLine {
  id            String      @id @default(cuid())
  transactionId String
  accountId     String
  debit         Decimal     @default(0) @db.Decimal(15, 2)
  credit        Decimal     @default(0) @db.Decimal(15, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  account       Account     @relation(fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("journal_lines")
}

model Greenhouse {
  id                   String         @id @default(cuid())
  code                 String         @unique
  name                 String
  location             String?
  area                 Decimal?       @db.Decimal(8, 2)
  isActive             Boolean        @default(true)
  fixedCostElectricity Decimal        @default(0) @db.Decimal(15, 2)
  electricityNotes     String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  installations        Installation[]

  @@map("greenhouses")
}

model Installation {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  type              InstallationType
  totalSlots        Int?
  isActive          Boolean           @default(true)
  greenhouseId      String
  fixedCostNutrient Decimal           @default(0) @db.Decimal(15, 2)
  nutrientNotes     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  greenhouse        Greenhouse        @relation(fields: [greenhouseId], references: [id])
  productionCycles  ProductionCycle[]

  @@map("installations")
}

model ProductionCycle {
  id                String          @id @default(cuid())
  batchCode         String          @unique
  plantType         String
  phase             PlantPhase      @default(SEMAI)
  initialQuantity   Int
  currentQuantity   Int
  rejectedCount     Int             @default(0)
  startDate         DateTime        @default(now())
  harvestDate       DateTime?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  fixedCostMedia    Decimal         @default(0) @db.Decimal(15, 2)
  fixedCostSeed     Decimal         @default(0) @db.Decimal(15, 2)
  installationId    String?
  activeSeedPackId  String?
  activeMediaPackId String?
  harvestReports    HarvestReport[]
  activeMediaPack   ActivePack?     @relation("MediaPackRelation", fields: [activeMediaPackId], references: [id])
  activeSeedPack    ActivePack?     @relation("SeedPackRelation", fields: [activeSeedPackId], references: [id])
  installation      Installation?   @relation(fields: [installationId], references: [id])
  productionLogs    ProductionLog[]

  @@map("production_cycles")
}

model ProductionLog {
  id        String           @id @default(cuid())
  cycleId   String
  action    ProductionAction
  fromPhase PlantPhase?
  toPhase   PlantPhase?
  quantity  Int?
  notes     String?
  photoUrl  String?
  userId    String
  createdAt DateTime         @default(now())
  cycle     ProductionCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])

  @@map("production_logs")
}

model InventoryItem {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  category      String
  unit          String
  currentStock  Decimal           @default(0) @db.Decimal(10, 2)
  minStock      Decimal           @default(0) @db.Decimal(10, 2)
  unitPrice     Decimal           @default(0) @db.Decimal(15, 2)
  description   String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  activePacks   ActivePack[]
  inventoryLogs InventoryLog[]
  salesItems    SalesOrderItem[]  @relation("SalesOrderInventory")
  packagingUsed SalesOrderItem[]  @relation("SalesOrderPackaging")

  @@map("inventory_items")
}

model InventoryLog {
  id        String            @id @default(cuid())
  itemId    String
  movement  InventoryMovement
  quantity  Decimal           @db.Decimal(10, 2)
  reference String?
  notes     String?
  userId    String
  createdAt DateTime          @default(now())
  item      InventoryItem     @relation(fields: [itemId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@map("inventory_logs")
}

model ActivePack {
  id                    String            @id @default(cuid())
  itemId                String
  status                ActivePackStatus  @default(DIBUKA)
  openedAt              DateTime          @default(now())
  depletedAt            DateTime?
  packPrice             Decimal           @db.Decimal(15, 2)
  estimatedYield        Int?
  costPerUnit           Decimal?          @db.Decimal(15, 4)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  currentQty            Decimal?          @db.Decimal(10, 2)
  openedQty             Decimal?          @db.Decimal(10, 2)
  item                  InventoryItem     @relation(fields: [itemId], references: [id])
  mediaProductionCycles ProductionCycle[] @relation("MediaPackRelation")
  seedProductionCycles  ProductionCycle[] @relation("SeedPackRelation")

  @@map("active_packs")
}

model Withdrawal {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(15, 2)
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("withdrawals")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model CustomCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("custom_categories")
}

model CategoryRequest {
  id           String              @id @default(cuid())
  name         String              @unique
  status       HarvestReportStatus @default(PENDING)
  requestedById String
  requestedBy  User                @relation("CategoryRequestedBy", fields: [requestedById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("category_requests")
}

model HarvestReport {
  id                   String              @id @default(cuid())
  cycleId              String
  harvestQuantity      Decimal             @db.Decimal(10, 2)
  harvestUnit          String              @default("kg")
  workerNotes          String?
  status               HarvestReportStatus @default(PENDING)
  hppPerUnit           Decimal?            @db.Decimal(15, 2)
  hppNotes             String?
  costSeed             Decimal?            @db.Decimal(15, 2)
  costNutrient         Decimal?            @db.Decimal(15, 2)
  costMedia            Decimal?            @db.Decimal(15, 2)
  costLabor            Decimal?            @db.Decimal(15, 2)
  costOther            Decimal?            @db.Decimal(15, 2)
  submittedById        String
  reviewedById         String?
  reviewedAt           DateTime?
  journalTransactionId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  costElectricity      Decimal?            @db.Decimal(15, 2)
  cycle                ProductionCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewedBy           User?               @relation("HarvestReviewed", fields: [reviewedById], references: [id])
  submittedBy          User                @relation("HarvestSubmitted", fields: [submittedById], references: [id])

  @@map("harvest_reports")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String?
  address     String?
  type        String       @default("PERSONAL")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  salesOrders SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  customerId      String?
  status          OrderStatus      @default(DRAFT)
  paymentStatus   PaymentStatus    @default(UNPAID)
  totalAmount     Decimal          @default(0) @db.Decimal(15, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(15, 2)
  costPackaging   Decimal          @default(0) @db.Decimal(15, 2)
  costDelivery    Decimal          @default(0) @db.Decimal(15, 2)
  shippingAddress String?
  notes           String?
  transactionId   String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deliveries      DeliveryLog[]
  items           SalesOrderItem[]
  customer        Customer?        @relation(fields: [customerId], references: [id])

  @@map("sales_orders")
}

model SalesOrderItem {
  id              String         @id @default(cuid())
  orderId         String
  inventoryItemId String
  quantity        Decimal        @db.Decimal(10, 2)
  unitPrice       Decimal        @db.Decimal(15, 2)
  totalPrice      Decimal        @db.Decimal(15, 2)
  packagingItemId String?
  packagingQty    Decimal?       @db.Decimal(10, 2)
  inventoryItem   InventoryItem  @relation("SalesOrderInventory", fields: [inventoryItemId], references: [id])
  order           SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packagingItem   InventoryItem? @relation("SalesOrderPackaging", fields: [packagingItemId], references: [id])

  @@map("sales_order_items")
}

model DeliveryLog {
  id           String         @id @default(cuid())
  orderId      String
  kurirId      String?
  status       DeliveryStatus @default(PENDING)
  deliveryDate DateTime?
  notes        String?
  photoUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  kurir        User?          @relation(fields: [kurirId], references: [id])
  order        SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("delivery_logs")
}

enum UserRole {
  OWNER
  ADMIN
  PEKERJA
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum InstallationType {
  SEMAI_TRAY
  DFT
  NFT
  DWC
  WICK
}

enum PlantPhase {
  SEMAI
  BIBIT
  TANAM
  PANEN
  REJECTED
}

enum ProductionAction {
  PHASE_CHANGE
  QUANTITY_UPDATE
  HARVEST
  REJECT
  NOTE
  SEMAI_BENIH
  SULAM
  MOVE_TO_TANAM
  TRANSPLANT_KOLAM
}

enum InventoryCategory {
  NUTRISI
  MEDIA
  BENIH
  KEMASAN
  ALAT
  LAINNYA
}

enum InventoryMovement {
  IN
  OUT
  ADJUST
}

enum ActivePackStatus {
  DIBUKA
  HABIS
}

enum HarvestReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum DeliveryStatus {
  PENDING
  SHIPPING
  DELIVERED
  FAILED
}
